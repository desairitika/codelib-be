# CodeLib .env example
# Copy this file to a local file named `.env` and fill real values.
# Never commit your `.env` to version control. This file contains secrets.

# Application
# Set the node environment: development | production | test
NODE_ENV=development

# Server port
PORT=3001

# Database (MongoDB)
# Example: mongodb://username:password@host:port/database?options
MONGODB_URI=mongodb://localhost:27017/codelib-dev

# Secret used to sign JWT tokens. Use a long, random string in production.
SECRET_KEY=change_this_to_a_strong_random_value

# Email (Gmail) - used for sending password reset / notifications
# If you use OAuth2, provide CLIENT_ID, CLIENT_SECRET and REFRESH_TOKEN
GMAIL_USER=codelib.noreply@gmail.com
#GMAIL_PASSWORD=your_app_password_if_using_basic_auth
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#REFRESH_TOKEN=

# Optional: Logging
#LOG_LEVEL=info
#LOG_DIR=./logs

# Optional: CORS
# A comma separated list of allowed origins for CORS
#ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Rate limiting (values used by in-memory limiter)
#RATE_LIMIT_WINDOW_MS=900000
#RATE_LIMIT_MAX_ATTEMPTS=5

# Optional: Third-party integrations
#SENTRY_DSN=
#OTHER_SERVICE_API_KEY=

# Notes:
# - After creating your local `.env`, restart the server so new values take effect.
# - For production, use a secrets manager (Vault, AWS Secrets Manager, etc.) instead of a plain `.env` file.
