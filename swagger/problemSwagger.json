{
  "/problems": {
    "get": {
      "summary": "Get list of problem",
      "description": "Endpoint to retrieve list of problems",
      "tags": ["Problems"],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Success"
        },
        "500": {
          "description": "Internal server error. Something went wrong on the server side."
        }
      }
    },
    "post": {
      "summary": "Create your problem",
      "description": "Endpoint to create problems",
      "tags": ["Problems"],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "difficulty": {
                  "type": "string",
                  "enum": ["Easy", "Medium", "Hard"],
                  "description": "You can choose one of the following options: Easy, Medium, Hard"
                },
                "tags": {
                  "type": "array"
                },
                "category": {
                  "type": "array"
                }
              },
              "required": ["title", "description"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Created Successfully"
        },
        "500": {
          "description": "Internal server error. Something went wrong on the server side."
        }
      }
    }
  },
  "/problems/{problemId}": {
    "get": {
      "summary": "Get problem by ID",
      "description": "Retrieve problem details by ID",
      "tags": ["Problems"],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "problemId",
          "in": "path",
          "description": "ID of the problem to retrieve",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Successful operation"
        },
        "500": {
          "description": "Internal server error. Something went wrong on the server side."
        }
      }
    },
    "put": {
      "summary": "Update problem by ID",
      "description": "Update problem details by ID",
      "tags": ["Problems"],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "problemId",
          "in": "path",
          "description": "ID of the problem to update",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "difficulty": {
                  "type": "string",
                  "enum": ["Easy", "Medium", "Hard"],
                  "description": "You can choose one of the following options: Easy, Medium, Hard"
                },
                "tags": {
                  "type": "array"
                },
                "category": {
                  "type": "array"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Problem updated successfully"
        },
        "500": {
          "description": "Internal server error. Something went wrong on the server side."
        }
      }
    },
    "delete": {
      "summary": "Delete problem by ID",
      "description": "Delete problem by ID",
      "tags": ["Problems"],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "problemId",
          "in": "path",
          "description": "ID of the problem to delete",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "responses": {
        "204": {
          "description": "Problem deleted successfully"
        },
        "401": {
          "description": "Unauthorized. Authentication is missing or invalid."
        },
        "403": {
          "description": "Forbidden. User does not have permission to access this resource."
        },
        "404": {
          "description": "Problem not found"
        },
        "500": {
          "description": "Internal server error. Something went wrong on the server side."
        }
      }
    }
  }
}
